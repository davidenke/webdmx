{
  "name": "@webdmx/common",
  "version": "0.0.1",
  "description": "Package for common code used in other webdmx packages",
  "author": {
    "name": "David Enke",
    "email": "david@enke.dev"
  },
  "license": "MIT",
  "type": "module",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "npm run build",
    "check": "tsc --noEmit",
    "lint": "run-s -ln lint:*",
    "lint:eslint": "eslint -c eslint.config.ts",
    "lint:prettier": "prettier --check .",
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "devDependencies": {
    "@awmottaz/prettier-plugin-void-html": "2.2.1",
    "@enke.dev/lint": "0.13.8",
    "@types/node": "24.13.3",
    "eslint": "10.8.1",
    "jiti": "2.7.0",
    "npm-run-all2": "9.0.3",
    "prettier": "3.9.6",
    "shx": "0.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vite-plugin-dts": "5.0.3"
  }
}
