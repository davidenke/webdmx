  "type": "module",
  "bin": {
    "convert-fixture": "dist/bin.js",
    "xfix": "dist/bin.js"
  },
  "module": "dist/bin.js",
  "types": "dist/bin.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "npm run build",
    "check": "tsc --noEmit",
    "lint": "run-s -ln lint:*",
    "lint:eslint": "eslint -c eslint.config.ts",
    "lint:prettier": "prettier --check .",
    "clean": "shx rm -rf dist encoded/*",
    "build": "vite build",
    "dev": "tsx src/bin.ts --source ./fixtures --target ./encoded"
  },
  "dependencies": {
    "@webdmx/common": "workspace:*",
    "cli-progress": "3.12.0",
    "plist": "5.0.0"
  },
  "devDependencies": {
    "@awmottaz/prettier-plugin-void-html": "2.2.1",
    "@enke.dev/lint": "0.13.8",
    "@types/cli-progress": "3.11.6",
    "@types/node": "24.13.3",
    "@types/plist": "3.0.5",
    "eslint": "10.8.1",
    "jiti": "2.7.0",
    "npm-run-all2": "9.0.3",
    "prettier": "3.9.6",
    "shx": "0.4.0",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1"
  }
